{
    // the app's compilation (@analogjs/vite-plugin-angular emits through it: no `noEmit`)
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false
    },
    "include": [
        "src/**/*.ts",
        "../../packages/angular/src/**/*.ts",
        "../../packages/angular/internal/**/*.ts",
        "../../packages/angular/selection/**/*.ts",
        "../../packages/angular/drag-and-drop/**/*.ts",
        "../../packages/angular/resize/**/*.ts",
        "../../packages/angular/external-drop/**/*.ts",
        "../../packages/angular/now-indicator/**/*.ts",
        "../../packages/angular/constraints/**/*.ts",
        "../../packages/angular/recurrence/**/*.ts",
        "../../packages/angular/event-sources/**/*.ts"
    ]
}
