{
    "name": "@fragiola/calendar-vue",
    "version": "0.0.0",
    "description": "Composable, headless Vue 3 primitives and composables for @fragiola/calendar: an accessible event calendar (month, week, day and list views) you assemble and style yourself.",
    "keywords": [
        "vue",
        "calendar",
        "event-calendar",
        "scheduler",
        "headless",
        "accessibility",
        "aria",
        "drag-and-drop"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/calendar.git",
        "directory": "packages/vue"
    },
    "homepage": "https://fragiola.com/calendar",
    "bugs": {
        "url": "https://github.com/fragiola/calendar/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./selection": {
            "@fragiola/source": "./src/selection/index.ts",
            "types": "./dist/selection.d.ts",
            "import": "./dist/selection.js",
            "default": "./dist/selection.js"
        },
        "./drag-and-drop": {
            "@fragiola/source": "./src/drag-and-drop/index.ts",
            "types": "./dist/drag-and-drop.d.ts",
            "import": "./dist/drag-and-drop.js",
            "default": "./dist/drag-and-drop.js"
        },
        "./resize": {
            "@fragiola/source": "./src/resize/index.ts",
            "types": "./dist/resize.d.ts",
            "import": "./dist/resize.js",
            "default": "./dist/resize.js"
        },
        "./external-drop": {
            "@fragiola/source": "./src/external-drop/index.ts",
            "types": "./dist/external-drop.d.ts",
            "import": "./dist/external-drop.js",
            "default": "./dist/external-drop.js"
        },
        "./now-indicator": {
            "@fragiola/source": "./src/now-indicator/index.ts",
            "types": "./dist/now-indicator.d.ts",
            "import": "./dist/now-indicator.js",
            "default": "./dist/now-indicator.js"
        },
        "./constraints": {
            "@fragiola/source": "./src/constraints/index.ts",
            "types": "./dist/constraints.d.ts",
            "import": "./dist/constraints.js",
            "default": "./dist/constraints.js"
        },
        "./recurrence": {
            "@fragiola/source": "./src/recurrence/index.ts",
            "types": "./dist/recurrence.d.ts",
            "import": "./dist/recurrence.js",
            "default": "./dist/recurrence.js"
        },
        "./event-sources": {
            "@fragiola/source": "./src/event-sources/index.ts",
            "types": "./dist/event-sources.d.ts",
            "import": "./dist/event-sources.js",
            "default": "./dist/event-sources.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./selection": {
                "types": "./dist/selection.d.ts",
                "import": "./dist/selection.js",
                "default": "./dist/selection.js"
            },
            "./drag-and-drop": {
                "types": "./dist/drag-and-drop.d.ts",
                "import": "./dist/drag-and-drop.js",
                "default": "./dist/drag-and-drop.js"
            },
            "./resize": {
                "types": "./dist/resize.d.ts",
                "import": "./dist/resize.js",
                "default": "./dist/resize.js"
            },
            "./external-drop": {
                "types": "./dist/external-drop.d.ts",
                "import": "./dist/external-drop.js",
                "default": "./dist/external-drop.js"
            },
            "./now-indicator": {
                "types": "./dist/now-indicator.d.ts",
                "import": "./dist/now-indicator.js",
                "default": "./dist/now-indicator.js"
            },
            "./constraints": {
                "types": "./dist/constraints.d.ts",
                "import": "./dist/constraints.js",
                "default": "./dist/constraints.js"
            },
            "./recurrence": {
                "types": "./dist/recurrence.d.ts",
                "import": "./dist/recurrence.js",
                "default": "./dist/recurrence.js"
            },
            "./event-sources": {
                "types": "./dist/event-sources.d.ts",
                "import": "./dist/event-sources.js",
                "default": "./dist/event-sources.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/calendar": "workspace:*"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.2",
        "@vue/test-utils": "2.5.1",
        "jsdom": "31.0.1",
        "tsdown": "0.23.7",
        "typescript": "6.0.3",
        "vite": "8.3.8",
        "vitest": "5.1.0",
        "vue": "3.5.45",
        "vue-tsc": "3.3.14"
    }
}
