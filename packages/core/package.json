{
    "name": "@fragiola/calendar",
    "version": "0.0.0",
    "description": "Headless, accessible event calendar: a typed model with a command bus, month, week, day and list views, time zones, recurring events, and pointer and keyboard gestures.",
    "keywords": [
        "calendar",
        "event-calendar",
        "scheduler",
        "headless",
        "accessibility",
        "aria",
        "time-zone",
        "recurrence"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/calendar.git",
        "directory": "packages/core"
    },
    "homepage": "https://fragiola.com/calendar",
    "bugs": {
        "url": "https://github.com/fragiola/calendar/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./recurrence": {
            "@fragiola/source": "./src/recurrence/index.ts",
            "types": "./dist/recurrence.d.ts",
            "import": "./dist/recurrence.js",
            "default": "./dist/recurrence.js"
        },
        "./constraints": {
            "@fragiola/source": "./src/constraints/index.ts",
            "types": "./dist/constraints.d.ts",
            "import": "./dist/constraints.js",
            "default": "./dist/constraints.js"
        },
        "./event-sources": {
            "@fragiola/source": "./src/event-sources/index.ts",
            "types": "./dist/event-sources.d.ts",
            "import": "./dist/event-sources.js",
            "default": "./dist/event-sources.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./recurrence": {
                "types": "./dist/recurrence.d.ts",
                "import": "./dist/recurrence.js",
                "default": "./dist/recurrence.js"
            },
            "./constraints": {
                "types": "./dist/constraints.d.ts",
                "import": "./dist/constraints.js",
                "default": "./dist/constraints.js"
            },
            "./event-sources": {
                "types": "./dist/event-sources.d.ts",
                "import": "./dist/event-sources.js",
                "default": "./dist/event-sources.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "generate:commands": "tsdown && node scripts/generate-command-docs.ts"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "tsdown": "0.23.7",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    }
}
