{
    "name": "@fragiola/calendar-angular",
    "version": "0.0.0",
    "description": "Composable, headless Angular directives and injection functions for @fragiola/calendar: an accessible event calendar (month, week, day and list views) you assemble and style yourself.",
    "keywords": [
        "angular",
        "calendar",
        "event-calendar",
        "scheduler",
        "headless",
        "accessibility",
        "aria",
        "drag-and-drop"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/calendar.git",
        "directory": "packages/angular"
    },
    "homepage": "https://fragiola.com/calendar",
    "bugs": {
        "url": "https://github.com/fragiola/calendar/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/public-api.ts",
            "types": "./dist/types/fragiola-calendar-angular.d.ts",
